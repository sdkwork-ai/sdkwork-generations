  "components": {
    "gatewayAssembly": {
      "crate": "sdkwork-api-generations-assembly",
      "manifest": "crates/sdkwork-api-generations-assembly/assembly-manifest.json"
    }
  },
  "orchestration": {
    "profiles": {
      "standalone.development": {
        "processes": [
          {
            "id": "application.public-ingress",
            "crate": "sdkwork-api-generations-assembly",
            "binary": "sdkwork-api-generations-assembly",
            "required": true,
            "role": "api-standalone-gateway"
          },
          {
            "id": "generations-browser",
            "role": "client",
            "applicationRoot": "apps/sdkwork-generations-pc",
            "bindEnv": "SDKWORK_GENERATIONS_WEB_DEV_INGRESS_BIND",
            "runtimeTargets": [
              "browser"
            ],
            "clientArchitectures": [
              "pc-web",
              "h5"
            ],
            "required": true
          }
        ],
        "healthSurfaces": [
          "application.public-ingress"
        ],
        "browserDeliveries": [
          {
            "id": "generations-adaptive-web",
            "applicationRoot": "apps/sdkwork-generations-pc",
            "clientArchitectures": [
              "pc-web",
              "h5"
            ],
            "originMode": "same-origin",
            "deliveryMode": "dev-server-proxy",
            "clientProcessId": "generations-browser",
            "apiSurfaceId": "application.public-ingress",
            "preserveCanonicalPaths": true,
            "tabletArchitecture": "pc-web",
            "renderers": {
              "pc-web": {
                "applicationRoot": "apps/sdkwork-generations-pc",
                "script": "dev",
                "defaultPort": 5677,
                "portEnv": "SDKWORK_GENERATIONS_PC_INTERNAL_DEV_PORT",
                "env": {}
              },
              "h5": {
                "applicationRoot": "apps/sdkwork-generations-h5",
                "script": "dev",
                "defaultPort": 5678,
                "portEnv": "SDKWORK_GENERATIONS_H5_INTERNAL_DEV_PORT",
                "env": {}
              }
            }
          }
        ]
      },
      "cloud.production": {
        "processes": [],
        "healthSurfaces": [
          "application.public-ingress",
          "platform.api-gateway"
        ]
      },
      "standalone.test": {
        "processes": [
          {
            "id": "application.public-ingress",
            "crate": "sdkwork-api-generations-assembly",
