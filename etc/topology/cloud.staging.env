# Bootstrap profile cloud.staging — replace with application-specific values.
SDKWORK_GENERATIONS_DEPLOYMENT_PROFILE=cloud
SDKWORK_GENERATIONS_ENVIRONMENT=staging
SDKWORK_GENERATIONS_PROFILE_ID=cloud.staging
SDKWORK_GENERATIONS_APPLICATION_PUBLIC_HTTP_URL=https://generations-staging.sdkwork.com
SDKWORK_GENERATIONS_PLATFORM_API_GATEWAY_HTTP_URL=https://api-staging.sdkwork.com


# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_GENERATIONS_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

