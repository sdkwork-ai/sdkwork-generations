# Isolated demo environment (standalone.demo).
# Independent database schema: sdkwork_generations_demo
# Independent Redis prefix: generations-demo (logical DB index 9) to avoid sharing conflicts on a shared Redis.
SDKWORK_GENERATIONS_DEPLOYMENT_PROFILE=standalone
SDKWORK_GENERATIONS_ENVIRONMENT=demo
SDKWORK_GENERATIONS_PROFILE_ID=standalone.demo
SDKWORK_GENERATIONS_APPLICATION_PUBLIC_HTTP_URL=https://generations-demo.sdkwork.com
SDKWORK_GENERATIONS_WEB_DEV_INGRESS_BIND=127.0.0.1:5675
SDKWORK_GENERATIONS_PC_INTERNAL_DEV_PORT=5677
SDKWORK_GENERATIONS_H5_INTERNAL_DEV_PORT=5678
