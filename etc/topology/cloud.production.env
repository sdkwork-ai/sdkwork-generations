# Bootstrap profile cloud.production — replace with application-specific values.
SDKWORK_GENERATIONS_DEPLOYMENT_PROFILE=cloud
SDKWORK_GENERATIONS_ENVIRONMENT=production
SDKWORK_GENERATIONS_PROFILE_ID=cloud.production
SDKWORK_GENERATIONS_APPLICATION_PUBLIC_HTTP_URL=https://generations.sdkwork.com
SDKWORK_GENERATIONS_PLATFORM_API_GATEWAY_HTTP_URL=https://api.sdkwork.com


# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_GENERATIONS_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

SDKWORK_CORS_ALLOWED_ORIGINS=https://generations.sdkwork.com,https://generations.birdcoder.com,https://generations.dtupay.com,https://generations.noaper.com,https://generations.sdkwork.cn,https://generations.birdcoder.cn,https://generations.dtupay.cn,https://generations.noaper.cn,https://generations.skubc.com,https://generations.skubc.cn,https://generations.zowalk.com,https://generations.zowalk.cn,https://generations.offer86.com,https://generations.offer86.cn,https://generations.86offer.com,https://generations.86offer.cn,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,tauri://localhost,https://servicewechat.com
