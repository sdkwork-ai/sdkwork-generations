# Isolated demo environment (cloud.demo).
# Independent database schema: sdkwork_generations_demo
# Independent Redis prefix: generations-demo (logical DB index 9) to avoid sharing conflicts on a shared Redis.
SDKWORK_GENERATIONS_DEPLOYMENT_PROFILE=cloud
SDKWORK_GENERATIONS_ENVIRONMENT=demo
SDKWORK_GENERATIONS_PROFILE_ID=cloud.demo
SDKWORK_GENERATIONS_APPLICATION_PUBLIC_HTTP_URL=https://generations-demo.sdkwork.com
SDKWORK_GENERATIONS_PLATFORM_API_GATEWAY_HTTP_URL=https://api-demo.sdkwork.com
SDKWORK_GENERATIONS_WEB_DEV_INGRESS_BIND=127.0.0.1:5675
SDKWORK_GENERATIONS_PC_INTERNAL_DEV_PORT=5677
SDKWORK_GENERATIONS_H5_INTERNAL_DEV_PORT=5678


# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_GENERATIONS_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN
SDKWORK_CORS_ALLOWED_ORIGINS=https://generations-demo.sdkwork.com,http://generations-demo.sdkwork.com,https://generations-demo.birdcoder.com,http://generations-demo.birdcoder.com,https://generations-demo.dtupay.com,http://generations-demo.dtupay.com,https://generations-demo.noaper.com,http://generations-demo.noaper.com,https://generations-demo.sdkwork.cn,http://generations-demo.sdkwork.cn,https://generations-demo.birdcoder.cn,http://generations-demo.birdcoder.cn,https://generations-demo.dtupay.cn,http://generations-demo.dtupay.cn,https://generations-demo.noaper.cn,http://generations-demo.noaper.cn,https://generations-demo.skubc.com,http://generations-demo.skubc.com,https://generations-demo.skubc.cn,http://generations-demo.skubc.cn,https://generations-demo.zowalk.com,http://generations-demo.zowalk.com,https://generations-demo.zowalk.cn,http://generations-demo.zowalk.cn,https://generations-demo.offer86.com,http://generations-demo.offer86.com,https://generations-demo.offer86.cn,http://generations-demo.offer86.cn,https://generations-demo.86offer.com,http://generations-demo.86offer.com,https://generations-demo.86offer.cn,http://generations-demo.86offer.cn,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,tauri://localhost,https://servicewechat.com
