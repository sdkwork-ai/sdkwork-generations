# Bootstrap profile cloud.development — replace with application-specific values.
SDKWORK_GENERATIONS_DEPLOYMENT_PROFILE=cloud
SDKWORK_GENERATIONS_ENVIRONMENT=development
SDKWORK_GENERATIONS_PROFILE_ID=cloud.development
SDKWORK_GENERATIONS_APPLICATION_PUBLIC_HTTP_URL=https://generations-dev.sdkwork.com
SDKWORK_GENERATIONS_PLATFORM_API_GATEWAY_HTTP_URL=https://api-dev.sdkwork.com
SDKWORK_GENERATIONS_WEB_DEV_INGRESS_BIND=127.0.0.1:5675
SDKWORK_GENERATIONS_PC_INTERNAL_DEV_PORT=5677
SDKWORK_GENERATIONS_H5_INTERNAL_DEV_PORT=5678


# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_GENERATIONS_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN


# dev:cloud local debugging override (vite dev surface only; PNPM_SCRIPT_SPEC section 3).
# The domain edges above stay authoritative for cloud-mode builds and deployed
# services. The development runtime instead binds every gateway-attached base
# URL to the sdkwork-api-cloud-gateway started by its own dev command
# (bind 127.0.0.1:3900), so dev:cloud quick-starts and debugs against the
# local gateway process.
SDKWORK_LOCAL_PLATFORM_API_GATEWAY_HTTP_URL=http://127.0.0.1:3900
SDKWORK_CORS_ALLOWED_ORIGINS=http://127.0.0.1:5675,http://localhost:5675,https://generations-dev.sdkwork.com,http://generations-dev.sdkwork.com,https://generations-dev.birdcoder.com,http://generations-dev.birdcoder.com,https://generations-dev.dtupay.com,http://generations-dev.dtupay.com,https://generations-dev.noaper.com,http://generations-dev.noaper.com,https://generations-dev.sdkwork.cn,http://generations-dev.sdkwork.cn,https://generations-dev.birdcoder.cn,http://generations-dev.birdcoder.cn,https://generations-dev.dtupay.cn,http://generations-dev.dtupay.cn,https://generations-dev.noaper.cn,http://generations-dev.noaper.cn,https://generations-dev.skubc.com,http://generations-dev.skubc.com,https://generations-dev.skubc.cn,http://generations-dev.skubc.cn,https://generations-dev.zowalk.com,http://generations-dev.zowalk.com,https://generations-dev.zowalk.cn,http://generations-dev.zowalk.cn,https://generations-dev.offer86.com,http://generations-dev.offer86.com,https://generations-dev.offer86.cn,http://generations-dev.offer86.cn,https://generations-dev.86offer.com,http://generations-dev.86offer.com,https://generations-dev.86offer.cn,http://generations-dev.86offer.cn,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,tauri://localhost,https://servicewechat.com
